{
  "name": "gofully",
  "version": "1.1.3",
  "description": "GoFully — Full page screenshot and screen capture Chrome extension with OCR, built-in editor, and PDF export",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:extension": "node build.mjs",
    "package:extension": "GF_RELEASE=1 node build.mjs && rm -f gofully-extension.zip && cd dist && zip -r ../gofully-extension.zip . -x '*.DS_Store' '*__MACOSX*' 'features/*' && cd .. && node scripts/verify-package.mjs --zip gofully-extension.zip --release",
    "dev:extension": "vite",
    "test": "playwright test",
    "test:e2e": "playwright test tests/e2e",
    "test:security": "playwright test tests/security",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "keywords": [
    "chrome-extension",
    "screenshot",
    "full-page",
    "capture"
  ],
  "author": "GoFully",
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@lucasmarkes/hairline": "^0.5.1",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "clsx": "^2.1.1",
    "cropperjs": "^1.6.2",
    "fabric": "^7.4.0",
    "jspdf": "^4.2.1",
    "jsqr": "1.4.0",
    "next": "^16.3.2",
    "ogl": "^1.0.11",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simplex-noise": "^4.0.3",
    "stackblur-canvas": "^3.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^4.1.1"
  }
}
